  "slides": [
    {
      "id": "s01",
      "type": "title",
      "title": "TraceBank 拾迹银行",
      "variant": "title",
      "slide_intent": "evidence",
      "message": "自然语言生成候选计划，服务端授权后执行，回执支持结果核验",
      "notes": "主讲约8分45秒，附录用于追问。介绍一次自然语言需求从计划到回执的实际路径。本系统已接入qwen3.8-flash，当前扩展六场景有离线证据，尚未完成新增六场景的完整真实模型回归。不要声称真实银行上线或通用自主重规划。\n代码与证据：problem.md、README.md、docs/current-release.md",
      "sources": [
        "problem.md、README.md、docs/current-release.md"
      ],
      "kicker": "银行 AI 智能体比赛",
      "subtitle": "系统架构、核心算法与安全设计\n模拟账户原型，代码18aa38d，2026-10-27",
      "caption": "代码基线18aa38d，材料重制2026-10-27。账户、资金、商户与验证码均为模拟。"
    },
    {
      "id": "s02",
      "type": "content",
      "title": "六类业务共用一套 Agent 执行内核",
      "variant": "table",
      "slide_intent": "evidence",
      "message": "六类场景\n同一执行内核\n全部模拟",
      "notes": "这里先明确覆盖范围。六类功能不是六套独立聊天提示词，它们共用工具契约、计划编排、银行权限与审计。用户可以从业务页进入工作台，连续追问保留历史，每轮操作绑定自己的operation。以下重点解释这套共同内核。\n代码与证据：data/birthday-evidence.json，固定模拟时钟2026-10-26；tools.py",
      "sources": [
        "data/birthday-evidence.json，固定模拟时钟2026-10-26；tools.py"
      ],
